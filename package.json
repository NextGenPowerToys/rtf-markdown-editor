{
  "name": "rtf-markdown-editor",
  "displayName": "RTF Markdown Editor",
  "description": "Word-like WYSIWYG Markdown Editor — Export Word/HTML/PDF, Import Word, AI-driven PDF → Markdown (via GitHub Copilot Chat), RTL-first (Hebrew/Arabic), Azure DevOps Mermaid, Autosave",
  "version": "2.6.0",
  "publisher": "NGPowerToys",
  "icon": "media/icons/RTFMD.png",
  "keywords": [
    "markdown",
    "editor",
    "editors",
    "wysiwyg",
    "rtl",
    "hebrew",
    "arabic",
    "persian",
    "urdu",
    "bidirectional",
    "bidi",
    "mermaid",
    "diagrams",
    "flowchart",
    "sequence-diagram",
    "diagram",
    "export",
    "html",
    "docx",
    "word",
    "microsoft-word",
    "document",
    "offline",
    "autosave",
    "word-like",
    "rich-text",
    "wysiwyg-editor",
    "markdown-editor",
    "github",
    "azure-devops",
    "technical-writing",
    "documentation",
    "rfc-7763",
    "import",
    "convert",
    "docx-to-markdown",
    "word-to-markdown",
    "pdf",
    "pdf-to-markdown",
    "pdf-import",
    "pdf-export",
    "ocr",
    "tesseract",
    "pdf-converter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NextGenPowerToys/rtf-markdown-editor"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Notebooks",
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "rtf-markdown-editor.editor",
        "displayName": "RTF Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rtf-markdown-editor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification"
        },
        {
          "command": "rtf-markdown-editor.exportDOCX",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification"
        },
        {
          "command": "rtf-markdown-editor.exportHTMLSelfContained",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification"
        },
        {
          "command": "rtf-markdown-editor.exportPDF",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification"
        },
        {
          "command": "rtf-markdown-editor.importDOCX",
          "when": "resourceExtname == .docx",
          "group": "1_modification"
        },
        {
          "command": "rtf-markdown-editor.importPDF",
          "when": "resourceExtname == .pdf && rtf-markdown-editor.aiChatAvailable",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "rtf-markdown-editor.openEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown) && activeCustomEditorId != 'rtf-markdown-editor.editor'",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "rtf-markdown-editor.openEditor",
        "title": "Edit with RTF Markdown Editor",
        "category": "RTF Markdown",
        "icon": {
          "light": "media/icons/RTFMD.png",
          "dark": "media/icons/RTFMD.png"
        }
      },
      {
        "command": "rtf-markdown-editor.exportHTMLSelfContained",
        "title": "Convert to Web Archive (HTML)",
        "category": "RTF Markdown"
      },
      {
        "command": "rtf-markdown-editor.exportDOCX",
        "title": "Convert to Word (DOCX)",
        "category": "RTF Markdown"
      },
      {
        "command": "rtf-markdown-editor.exportPDF",
        "title": "Convert to PDF",
        "category": "RTF Markdown"
      },
      {
        "command": "rtf-markdown-editor.importDOCX",
        "title": "Convert to Markdown",
        "category": "RTF Markdown"
      },
      {
        "command": "rtf-markdown-editor.importPDF",
        "title": "Convert PDF to Markdown (via GitHub Copilot Chat)",
        "category": "RTF Markdown"
      }
    ],
    "chatParticipants": [
      {
        "id": "rtf-markdown-editor.pdfChat",
        "fullName": "PDF to Markdown",
        "name": "pdfmd",
        "description": "Convert a PDF file to Markdown using the bundled PDF processing skill via GitHub Copilot Chat",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "RTF Markdown Editor",
      "properties": {
        "rtf-markdown-editor.defaultCharset": {
          "type": "string",
          "default": "UTF-8",
          "enum": [
            "UTF-8",
            "UTF-16LE",
            "UTF-16BE",
            "ISO-8859-1",
            "Windows-1252"
          ],
          "enumDescriptions": [
            "Unicode UTF-8 (recommended, universal)",
            "Unicode UTF-16 Little Endian",
            "Unicode UTF-16 Big Endian",
            "Latin-1 (Western European)",
            "Windows Latin-1 (Western European with extensions)"
          ],
          "description": "Default character encoding for new markdown files (RFC 7763 charset parameter)"
        },
        "rtf-markdown-editor.defaultVariant": {
          "type": "string",
          "default": "GFM",
          "enum": [
            "Original",
            "CommonMark",
            "GFM",
            "MultiMarkdown"
          ],
          "enumDescriptions": [
            "Original Markdown (Gruber 2004)",
            "CommonMark (standardized specification)",
            "GitHub-Flavored Markdown (GFM) - recommended",
            "MultiMarkdown (extended features)"
          ],
          "description": "Default markdown variant/flavor (RFC 7763 variant parameter)"
        },
        "rtf-markdown-editor.detectCharsetAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect file encoding when opening files"
        },
        "rtf-markdown-editor.showCharsetInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show character encoding in status bar"
        },
        "rtf-markdown-editor.showVariantInStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show markdown variant in status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run copy:mermaid && npm run copy:tess && npm run copy:skill && npm run esbuild-base -- --minify",
    "copy:mermaid": "node -e \"require('fs').copyFileSync('node_modules/mermaid/dist/mermaid.min.js', 'media/mermaid.min.js')\"",
    "copy:tess": "node -e \"const fs=require('fs'),path=require('path');const src='node_modules/tesseract.js-core';const dst='resources/tess-core';fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){if(/^tesseract-core.*\\.(js|wasm)$/.test(f))fs.copyFileSync(path.join(src,f),path.join(dst,f))}fs.mkdirSync('resources/tess-worker',{recursive:true});fs.copyFileSync('node_modules/tesseract.js/dist/worker.min.js','resources/tess-worker/worker.min.js');\"",
    "copy:skill": "node -e \"const fs=require('fs'),path=require('path');const src='.agents/skills/pdf';const dst='resources/skills/pdf';fs.mkdirSync(dst,{recursive:true});for(const f of ['SKILL.md','forms.md','reference.md','LICENSE.txt']){try{fs.copyFileSync(path.join(src,f),path.join(dst,f))}catch{}};\"",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:pdfjs-dist --external:tesseract.js --external:canvas --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "build:webview": "esbuild ./media/editor.ts --bundle --outfile=media/editor.bundle.js --format=iife --sourcemap",
    "build:webview-watch": "npm run build:webview -- --watch",
    "build": "npm run copy:mermaid && npm run copy:tess && npm run copy:skill && npm run esbuild && npm run build:webview",
    "watch": "concurrently \"npm run esbuild-watch\" \"npm run build:webview-watch\"",
    "compile": "tsc -p ./",
    "test": "jest",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^2.1.0",
    "@tiptap/extension-bold": "^2.1.0",
    "@tiptap/extension-bullet-list": "^2.1.0",
    "@tiptap/extension-code": "^2.1.0",
    "@tiptap/extension-code-block": "^2.1.0",
    "@tiptap/extension-color": "^2.1.0",
    "@tiptap/extension-document": "^2.1.0",
    "@tiptap/extension-heading": "^2.1.0",
    "@tiptap/extension-highlight": "^2.1.0",
    "@tiptap/extension-history": "^2.1.0",
    "@tiptap/extension-horizontal-rule": "^2.1.0",
    "@tiptap/extension-image": "^2.1.0",
    "@tiptap/extension-italic": "^2.1.0",
    "@tiptap/extension-link": "^2.1.0",
    "@tiptap/extension-list-item": "^2.1.0",
    "@tiptap/extension-ordered-list": "^2.1.0",
    "@tiptap/extension-paragraph": "^2.1.0",
    "@tiptap/extension-placeholder": "^2.1.0",
    "@tiptap/extension-strike": "^2.1.0",
    "@tiptap/extension-table": "^2.1.0",
    "@tiptap/extension-table-cell": "^2.1.0",
    "@tiptap/extension-table-header": "^2.1.0",
    "@tiptap/extension-table-row": "^2.1.0",
    "@tiptap/extension-text": "^2.1.0",
    "@tiptap/extension-text-align": "^2.1.0",
    "@tiptap/extension-underline": "^2.1.0",
    "@tiptap/pm": "^2.1.0",
    "@tiptap/starter-kit": "^2.1.0",
    "@types/pdf-parse": "^1.1.5",
    "adm-zip": "^0.5.16",
    "chardet": "^1.6.0",
    "he": "^1.2.0",
    "iconv-lite": "^0.6.3",
    "mammoth": "^1.11.0",
    "markdown-it": "^13.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "mermaid": "^10.6.0",
    "pdf-parse": "^1.1.1",
    "canvas": "^3.1.0",
    "pdfjs-dist": "^4.8.69",
    "puppeteer-core": "^24.37.4",
    "tesseract.js": "^5.1.1",
    "turndown": "^7.2.2"
  }
}
